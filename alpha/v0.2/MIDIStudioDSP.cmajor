// MIDI Studio v0.2 — forty authored four-bar composition starters.
processor MIDIStudio [[ main ]]
{
    input event std::midi::Message midiIn;
    output event std::midi::Message midiOut;
    input event float transportIn;
    output event float transportStateOut;
    output event float tempoOut;
    output event float pulseOut;
    output event float barOut;

    input event float param1 [[ name: "Instrument", min: 0, max: 9, init: 0, step: 1, text: "Piano|Lead Synth|Bass|Electric Keys|Pluck|Drums|Guitar|Strings|Flute|Brass" ]];
    input event float param2 [[ name: "Key", min: 0, max: 11, init: 0, step: 1, text: "C|C#|D|D#|E|F|F#|G|G#|A|A#|B" ]];
    input event float param3 [[ name: "Scale", min: 0, max: 1, init: 1, step: 1, text: "Major|Minor" ]];
    input event float param4 [[ name: "Octave Shift", min: -2, max: 2, init: 0, step: 1 ]];
    input event float param5 [[ name: "Speed", min: 0, max: 2, init: 1, step: 1, text: "Half|Normal|Double" ]];
    input event float param6 [[ name: "Length", min: 10, max: 100, init: 85, step: 1, unit: "%" ]];
    input event float param7 [[ name: "Velocity", min: 1, max: 127, init: 96, step: 1 ]];
    input event float param8 [[ name: "MIDI Channel", min: 1, max: 16, init: 1, step: 1 ]];
    input event float param9 [[ name: "Enabled", min: 0, max: 1, init: 1, step: 1, text: "Muted|Ready" ]];

    input event float param10 [[ name: "Variation", min: 0, max: 3, init: 0, step: 1, text: "Idea 1|Idea 2|Idea 3|Idea 4" ]];
    int variation = 0;

    int pattern = 0, keyRoot = 0, scaleMode = 1, octaveShift = 0, speed = 1, velocity = 96;
    float length = 0.85f;
    bool enabled = true;
    int midiChannel0 = 0;
    int transportSlot = 0;
    bool hostPlaying = false, transportSeen = false, rawPpqSeen = false, awaitingStartPpq = true;
    float hostTempo = 120.0f;
    int timeNumerator = 4, timeDenominator = 4;
    float64 currentPpq = 0.0, previousRawPpq = 0.0;
    int lastEmittedStep = -2147483647;
    bool[32] activeSlots;
    int[32] activeNotes;
    int[32] activeChannels;
    float64[32] activeOffPpq;
    int positiveModulo (int value, int divisor)
    {
        if (divisor <= 0) return 0;
        int result = value % divisor;
        if (result < 0) result += divisor;
        return result;
    }

    int floorToInt (float64 value)
    {
        int result = int (value);
        if (float64 (result) > value) result -= 1;
        return result;
    }

    float getBarLengthPpq()
    {
        return float (max (1, timeNumerator)) * 4.0f / float (max (1, timeDenominator));
    }

    void sendSlotNoteOff (int slot)
    {
        if (!activeSlots.at (slot)) return;
        midiOut <- std::midi::createMessage (0x80 + activeChannels.at (slot), activeNotes.at (slot), 0);
        activeSlots.at (slot) = false;
    }

    void stopAllNotes()
    {
        for (int i = 0; i < 32; i += 1)
            sendSlotNoteOff (i);
        midiOut <- std::midi::createMessage (0xB0 + midiChannel0, 123, 0);
    }

    void stopExpiredNotes (float64 position)
    {
        for (int i = 0; i < 32; i += 1)
            if (activeSlots.at (i) && position >= activeOffPpq.at (i))
                sendSlotNoteOff (i);
    }

    void emitNote (int note, int velocity, float64 position, float durationPpq)
    {
        int safeNote = clamp (note, 0, 127);
        int safeVelocity = clamp (velocity, 1, 127);

        // MIDI 1.0 cannot independently identify overlapping copies of the
        // same pitch/channel. Close the prior copy before a clean retrigger.
        for (int i = 0; i < 32; i += 1)
            if (activeSlots.at (i) && activeNotes.at (i) == safeNote && activeChannels.at (i) == midiChannel0)
                sendSlotNoteOff (i);

        for (int i = 0; i < 32; i += 1)
        {
            if (!activeSlots.at (i))
            {
                midiOut <- std::midi::createMessage (0x90 + midiChannel0, safeNote, safeVelocity);
                activeSlots.at (i) = true;
                activeNotes.at (i) = safeNote;
                activeChannels.at (i) = midiChannel0;
                activeOffPpq.at (i) = position + float64 (max (0.01f, durationPpq));
                return;
            }
        }
    }


    float tickPpq() { return speed == 0 ? 0.5f : (speed == 2 ? 0.125f : 0.25f); }
    int scaleOffset (int degree)
    {
        let major = int[7] (0, 2, 4, 5, 7, 9, 11);
        let minor = int[7] (0, 2, 3, 5, 7, 8, 10);
        int d = positiveModulo (degree, 7);
        int oct = floorToInt (float64 (degree) / 7.0);
        return 12 * oct + (scaleMode == 0 ? major.at (d) : minor.at (d));
    }
    void play (int degree, int base, int vel, float ticks)
    {
        emitNote (base + keyRoot + octaveShift * 12 + scaleOffset (degree), vel, currentPpq, ticks * tickPpq() * length);
    }
