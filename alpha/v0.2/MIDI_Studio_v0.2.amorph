  <Code>// MIDI Studio v0.2 &#8212; forty authored four-bar composition starters.
processor MIDIStudio [[ main ]]
{
    input event std::midi::Message midiIn;
    output event std::midi::Message midiOut;
    input event float transportIn;
    output event float transportStateOut;
    output event float tempoOut;
    output event float pulseOut;
    output event float barOut;

    input event float param1 [[ name: &quot;Instrument&quot;, min: 0, max: 9, init: 0, step: 1, text: &quot;Piano|Lead Synth|Bass|Electric Keys|Pluck|Drums|Guitar|Strings|Flute|Brass&quot; ]];
    input event float param2 [[ name: &quot;Key&quot;, min: 0, max: 11, init: 0, step: 1, text: &quot;C|C#|D|D#|E|F|F#|G|G#|A|A#|B&quot; ]];
    input event float param3 [[ name: &quot;Scale&quot;, min: 0, max: 1, init: 1, step: 1, text: &quot;Major|Minor&quot; ]];
    input event float param4 [[ name: &quot;Octave Shift&quot;, min: -2, max: 2, init: 0, step: 1 ]];
    input event float param5 [[ name: &quot;Speed&quot;, min: 0, max: 2, init: 1, step: 1, text: &quot;Half|Normal|Double&quot; ]];
    input event float param6 [[ name: &quot;Length&quot;, min: 10, max: 100, init: 85, step: 1, unit: &quot;%&quot; ]];
    input event float param7 [[ name: &quot;Velocity&quot;, min: 1, max: 127, init: 96, step: 1 ]];
    input event float param8 [[ name: &quot;MIDI Channel&quot;, min: 1, max: 16, init: 1, step: 1 ]];
    input event float param9 [[ name: &quot;Enabled&quot;, min: 0, max: 1, init: 1, step: 1, text: &quot;Muted|Ready&quot; ]];

    input event float param10 [[ name: &quot;Variation&quot;, min: 0, max: 3, init: 0, step: 1, text: &quot;Idea 1|Idea 2|Idea 3|Idea 4&quot; ]];
    int variation = 0;

    int pattern = 0, keyRoot = 0, scaleMode = 1, octaveShift = 0, speed = 1, velocity = 96;
    float length = 0.85f;
    bool enabled = true;
    int midiChannel0 = 0;
    int transportSlot = 0;
    bool hostPlaying = false, transportSeen = false, rawPpqSeen = false, awaitingStartPpq = true;
    float hostTempo = 120.0f;
    int timeNumerator = 4, timeDenominator = 4;
    float64 currentPpq = 0.0, previousRawPpq = 0.0;
    int lastEmittedStep = -2147483647;
    bool[32] activeSlots;
    int[32] activeNotes;
    int[32] activeChannels;
    float64[32] activeOffPpq;
    int positiveModulo (int value, int divisor)
    {
        if (divisor &lt;= 0) return 0;
        int result = value % divisor;
        if (result &lt; 0) result += divisor;
        return result;
    }

    int floorToInt (float64 value)
    {
        int result = int (value);
        if (float64 (result) &gt; value) result -= 1;
        return result;
    }

    float getBarLengthPpq()
    {
        return float (max (1, timeNumerator)) * 4.0f / float (max (1, timeDenominator));
    }

    void sendSlotNoteOff (int slot)
    {
        if (!activeSlots.at (slot)) return;
        midiOut &lt;- std::midi::createMessage (0x80 + activeChannels.at (slot), activeNotes.at (slot), 0);
        activeSlots.at (slot) = false;
    }

    void stopAllNotes()
    {
        for (int i = 0; i &lt; 32; i += 1)
            sendSlotNoteOff (i);
        midiOut &lt;- std::midi::createMessage (0xB0 + midiChannel0, 123, 0);
    }

    void stopExpiredNotes (float64 position)
    {
        for (int i = 0; i &lt; 32; i += 1)
            if (activeSlots.at (i) &amp;&amp; position &gt;= activeOffPpq.at (i))
                sendSlotNoteOff (i);
    }

    void emitNote (int note, int velocity, float64 position, float durationPpq)
    {
        int safeNote = clamp (note, 0, 127);
        int safeVelocity = clamp (velocity, 1, 127);

        // MIDI 1.0 cannot independently identify overlapping copies of the
        // same pitch/channel. Close the prior copy before a clean retrigger.
        for (int i = 0; i &lt; 32; i += 1)
            if (activeSlots.at (i) &amp;&amp; activeNotes.at (i) == safeNote &amp;&amp; activeChannels.at (i) == midiChannel0)
                sendSlotNoteOff (i);

        for (int i = 0; i &lt; 32; i += 1)
        {
            if (!activeSlots.at (i))
            {
                midiOut &lt;- std::midi::createMessage (0x90 + midiChannel0, safeNote, safeVelocity);
                activeSlots.at (i) = true;
                activeNotes.at (i) = safeNote;
                activeChannels.at (i) = midiChannel0;
                activeOffPpq.at (i) = position + float64 (max (0.01f, durationPpq));
                return;
            }
        }
    }


    float tickPpq() { return speed == 0 ? 0.5f : (speed == 2 ? 0.125f : 0.25f); }
    int scaleOffset (int degree)
    {
        let major = int[7] (0, 2, 4, 5, 7, 9, 11);
        let minor = int[7] (0, 2, 3, 5, 7, 8, 10);
        int d = positiveModulo (degree, 7);
        int oct = floorToInt (float64 (degree) / 7.0);
        return 12 * oct + (scaleMode == 0 ? major.at (d) : minor.at (d));
    }
    void play (int degree, int base, int vel, float ticks)
    {
        emitNote (base + keyRoot + octaveShift * 12 + scaleOffset (degree), vel, currentPpq, ticks * tickPpq() * length);
    }
    let offsets = int[2561] (0, 3, 3, 3, 4, 4, 4, 5, 5, 7, 7, 7, 8, 8, 8, 9, 9, 11, 11, 11, 12, 12, 12, 13, 13, 15, 15, 15, 16, 16, 16, 17, 17, 20, 20, 20, 21, 21, 21, 22, 22, 24, 24, 24, 25, 25, 25, 26, 26, 28, 28, 28, 29, 29, 29, 30, 30, 32, 32, 32, 33, 33, 33, 34, 34, 37, 37, 38, 38, 38, 39, 39, 39, 41, 41, 42, 42, 42, 42, 43, 43, 45, 45, 46, 46, 46, 47, 47, 47, 49, 49, 50, 50, 50, 50, 51, 51, 54, 54, 55, 55, 55, 56, 56, 56, 58, 58, 59, 59, 59, 59, 60, 60, 62, 62, 63, 63, 63, 64, 64, 64, 66, 66, 67, 67, 67, 67, 68, 68, 71, 71, 71, 72, 73, 73, 73, 73, 75, 75, 75, 76, 76, 76, 77, 77, 79, 79, 79, 80, 81, 81, 81, 81, 83, 83, 83, 84, 84, 84, 85, 85, 88, 88, 88, 89, 90, 90, 90, 90, 92, 92, 92, 93, 93, 93, 94, 94, 96, 96, 96, 97, 98, 98, 98, 98, 100, 100, 100, 101, 101, 101, 102, 102, 105, 105, 106, 106, 106, 106, 107, 107, 109, 109, 109, 109, 110, 110, 111, 111, 113, 113, 114, 114, 114, 114, 115, 115, 117, 117, 117, 117, 118, 118, 119, 119, 122, 122, 123, 123, 123, 123, 124, 124, 126, 126, 126, 126, 127, 127, 128, 128, 130, 130, 131, 131, 131, 131, 132, 132, 134, 134, 134, 134, 135, 135, 136, 136, 137, 137, 137, 138, 138, 138, 139, 139, 140, 140, 140, 141, 141, 141, 141, 141, 142, 142, 142, 143, 143, 143, 144, 144, 145, 145, 145, 146, 146, 146, 146, 146, 147, 147, 147, 148, 148, 148, 149, 149, 150, 150, 150, 151, 151, 151, 151, 151, 152, 152, 152, 153, 153, 153, 154, 154, 155, 155, 155, 156, 156, 156, 156, 156, 157, 157, 158, 158, 158, 159, 159, 159, 159, 160, 160, 160, 161, 161, 161, 161, 162, 162, 163, 163, 163, 164, 164, 164, 164, 165, 165, 165, 166, 166, 166, 166, 167, 167, 168, 168, 168, 169, 169, 169, 169, 170, 170, 170, 171, 171, 171, 171, 172, 172, 173, 173, 173, 174, 174, 174, 174, 175, 175, 175, 176, 176, 176, 176, 176, 177, 177, 177, 178, 178, 179, 179, 180, 180, 180, 180, 181, 181, 181, 181, 181, 182, 182, 182, 183, 183, 184, 184, 185, 185, 185, 185, 186, 186, 186, 186, 186, 187, 187, 187, 188, 188, 189, 189, 190, 190, 190, 190, 191, 191, 191, 191, 191, 192