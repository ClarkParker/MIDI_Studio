    let bases = int[10] (48, 60, 36, 60, 60, 0, 48, 48, 72, 60);
    void trigger (int step)
    {
        int s = positiveModulo (step, 64);
        pulseOut &lt;- float (s % 16);
        barOut &lt;- float (s / 16);
        int slot = (pattern * 4 + variation) * 64 + s;
        for (int i = offsets.at (slot); i &lt; offsets.at (slot + 1); i += 1)
        {
            int vel = clamp (int (float (velocities.at (i)) * float (velocity) / 96.0f), 1, 127);
            if (pattern == 5)
                emitNote (degrees.at (i), vel, currentPpq, durations.at (i) * tickPpq() * length);
            else
                play (degrees.at (i), bases.at (pattern), vel, durations.at (i));
        }
    }
    void resetScheduler()
    {
        stopAllNotes();
        lastEmittedStep = -2147483647;
    }
    event param1 (float v) { pattern = clamp (int (v), 0, 9); resetScheduler(); }
    event param2 (float v) { keyRoot = clamp (int (v), 0, 11); resetScheduler(); }
    event param3 (float v) { scaleMode = clamp (int (v), 0, 1); resetScheduler(); }
    event param4 (float v) { octaveShift = clamp (int (v), -2, 2); resetScheduler(); }
    event param5 (float v) { speed = clamp (int (v), 0, 2); resetScheduler(); }
    event param6 (float v) { length = clamp (v * 0.01f, 0.1f, 1.0f); }
    event param7 (float v) { velocity = clamp (int (v), 1, 127); }
    event param8 (float v) { resetScheduler(); midiChannel0 = clamp (int (v) - 1, 0, 15); }
    event param9 (float v) { enabled = v &gt;= 0.5f; resetScheduler(); }
    event param10 (float v) { int next = clamp (int (v), 0, 3); if (next != variation) { variation = next; resetScheduler(); } }
    event transportIn (float value)
    {
        if (value != value || abs (value) &gt; 100000000.0f) { transportSlot = (transportSlot + 1) % 6; return; }
        transportSeen = true;

        if (transportSlot == 0)
        {
            bool nextPlaying = value &gt; 0.5f;
            if (nextPlaying &amp;&amp; !hostPlaying)
            {
                awaitingStartPpq = true;
                rawPpqSeen = false;
                resetScheduler();
            }
            else if (!nextPlaying &amp;&amp; hostPlaying)
            {
                stopAllNotes();
                lastEmittedStep = -2147483647;
            }
            hostPlaying = nextPlaying;
            transportStateOut &lt;- hostPlaying ? 1.0f : 0.0f;
        }
        else if (transportSlot == 1)
        {
            hostTempo = clamp (value, 20.0f, 999.0f);
            tempoOut &lt;- hostTempo;
        }
        else if (transportSlot == 2)
        {
            int nextNumerator = max (1, int (value + 0.5f));
            if (nextNumerator != timeNumerator)
            {
                timeNumerator = nextNumerator;
                resetScheduler();
            }
        }
        else if (transportSlot == 3)
        {
            int nextDenominator = max (1, int (value + 0.5f));
            if (nextDenominator != timeDenominator)
            {
                timeDenominator = nextDenominator;
                resetScheduler();
            }
        }
        else if (transportSlot == 4)
        {
            float64 incomingPpq = float64 (value);
            bool backwardsJump = rawPpqSeen &amp;&amp; incomingPpq &lt; previousRawPpq - 0.000001;
            bool forwardSeek = rawPpqSeen &amp;&amp; incomingPpq &gt; currentPpq + 0.25;

            // Every valid host packet is authoritative. Discontinuity is
            // detected against the previous raw packet, never the locally
            // extrapolated position, so block re-anchors cannot double-fire.
            previousRawPpq = incomingPpq;
            currentPpq = incomingPpq;
            rawPpqSeen = true;
            awaitingStartPpq = false;

            if (backwardsJump || forwardSeek)
                resetScheduler();
        }
        else if (transportSlot == 5)
        {
            // Packet terminator; loops are fixed 4/4 phrases.
        }

        transportSlot = (transportSlot + 1) % 6;
    }


    event midiIn (std::midi::Message message)
    {
        // Generator owns note output, so incoming clips cannot double the loop.
        if (message.isAllNotesOff() || message.isAllSoundOff()) resetScheduler();
    }
    void main()
    {
        loop
        {
            if (hostPlaying &amp;&amp; transportSeen &amp;&amp; rawPpqSeen &amp;&amp; !awaitingStartPpq)
            {
                stopExpiredNotes (currentPpq);
                int step = floorToInt (currentPpq / float64 (tickPpq()));
                if (enabled &amp;&amp; (lastEmittedStep == -2147483647 || step &gt; lastEmittedStep))
                {
                    lastEmittedStep = step;
                    trigger (step);
                }
                currentPpq += float64 (hostTempo) / 60.0 / max (1.0, processor.frequency);
            }
            advance();
        }
    }
